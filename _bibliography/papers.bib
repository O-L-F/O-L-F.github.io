@unpublished{leverage2026,
  title    = {Of Leverage and Reform: The Consequences of EU Membership on Judicial Systems in Diverse Member States},
  author   = {Olivier Lesage Filippin},
  year     = {2026},
  note     = {Working paper},
  abstract = {This study investigates the relationship between EU membership and judicial development across diverse European states, focusing on the EU's role as a potential driver of institutional change. The central argument advanced is that the influence of the EU on judicial systems appears strongest during the candidacy and negotiation phases of the accession process, with the prospect of membership potentially serving as a more effective motivator than formal membership itself. The findings indicate limited and context-dependent support for the idea that EU affiliation corresponds with improvements in judicial quality. In particular, results suggest that membership status is not uniformly associated with judicial strengthening and may coincide with stagnation or decline in certain regions, especially in earlier enlargement waves and parts of Southern Europe. The evidence also points to a broader pattern in which judicial reform tends to decelerate or reverse following accession, suggesting that the most consequential period of EU influence may be temporally bounded. This study contributes to ongoing debates about Europeanization and conditionality by emphasizing the differentiated and time-sensitive nature of EU-related judicial reforms, while also foregrounding the regional heterogeneity in outcomes.}
}

@unpublished{peacekeepers2026,
  title    = {Blessed are the Peacekeepers: Elite Uncertainty and Judicial Strengthening in Post-Conflict States},
  author   = {Olivier Lesage Filippin},
  year     = {2026},
  note     = {Working paper},
  abstract = {Civil war frequently reshapes state institutions, yet its relationship to judicial development remains theoretically indeterminate and empirically contested. Existing accounts treat judicial reform as a functional response to post-conflict governance demands -- for territorial authority and/or economic reconstruction -- but cannot explain why rational self-interested elites would delegate authority to courts capable of constraining them. This scoping paper argues that the key explanatory variable is not conflict itself but the type of political uncertainty that a war's termination produces. Drawing on the insurance theory of judicial empowerment, it contends that negotiated settlements generate credible elite uncertainty about future political control, which incentivizes delegation of authority to judicial institutions as a form of institutional insurance against post-tenure punishment. Decisive military victories concentrate authority, suppress those incentives, and predict judicial weakening rather than strengthening. The paper extends the insurance framework beyond its original electoral setting: it develops a typology of post-conflict uncertainty, treats the severity of post-tenure loss as an independent driver of insurance demand, and distinguishes elite-driven delegation from technocratic institutionalization as competing causal pathways. A formal conditional model with an interaction between post-conflict status and political uncertainty generates three testable hypotheses, evaluated against a process-tracing case study of Liberia's 2003 Accra Comprehensive Peace Agreement.}
}

@unpublished{chechnya2025,
  title    = {The Paradox of Stability: Outsourced Sovereignty and Human Rights in Chechnya},
  author   = {Olivier Lesage Filippin},
  year     = {2025},
  note     = {Working paper},
  abstract = {This essay examines the paradox of stability produced by Russia's outsourced sovereignty in Chechnya, where Moscow has delegated core state functions to Ramzan Kadyrov's regime in exchange for order without direct accountability. Following the policy of Chechenization after the Second Chechen War, the federal center replaced legal governance with personalized loyalty, purchasing stability through subsidies and political latitude while distancing itself from the coercive practices that sustain Kadyrov's rule. Drawing on international legal frameworks -- particularly the ICCPR and the Responsibility to Protect -- this essay argues that rights-based development frameworks routinely fail where local authorities operate as a state within the state. Using Chechnya as a case study, it traces how outsourced sovereignty, transactional governance, and entrenched legal pluralism erode the state's duty to protect, rendering formal human rights guarantees largely toothless. The essay situates Chechnya within debates on state responsibility, analyzes the political logic of Chechenization as a deliberate protection gap, and shows how the region's apparent stability rests on the suppression, rather than the safeguarding, of rights.}
}
